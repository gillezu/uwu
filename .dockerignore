# Keep the build context small and never ship secrets or host-built artifacts.
.git
.gitignore
.idea
.vscode
.mcp.json
**/__pycache__
**/*.pyc
**/.venv
**/venv
**/node_modules
client/dist
**/.env
!**/.env.example
# Needed by the client build: it selects the same-origin API base.
!client/.env.production
**/.DS_Store
Dockerfile
.dockerignore
README.md
