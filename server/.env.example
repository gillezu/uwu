# Copy to server/.env and fill in.

# Port the Flask/Socket.IO server listens on.
# Do NOT use 5000 on macOS — AirPlay Receiver occupies it and returns HTTP 403.
PORT=5001

# Supabase project backing the pattern library (Library / Save / Load Pattern).
# The project that was previously hardcoded no longer exists, so you need to
# create a new one with a "Patterns" table containing "Name" and "Code" columns.
# Leave these unset to run the simulation without the pattern library.
SUPABASE_URL=
SUPABASE_KEY=
